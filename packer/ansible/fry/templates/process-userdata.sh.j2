#!/bin/bash
# Process EC2 userdata and apply runtime configuration

set -e

LOG_FILE="/var/log/fry-config.log"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

# Fetch userdata
USERDATA=$(curl -s http://169.254.169.254/latest/user-data)

if [ -z "$USERDATA" ] || [ "$USERDATA" == "404 - Not Found" ]; then
    log "No userdata found, using defaults"
    exit 0
fi

log "Userdata received, processing..."

# Parse userdata (expecting key=value format)
while IFS='=' read -r key value; do
    # Skip comments and empty lines
    [[ "$key" =~ ^#.*$ ]] && continue
    [[ -z "$key" ]] && continue
    
    # Remove quotes from value
    value=$(echo "$value" | tr -d '"' | tr -d "'")
    
    case "$key" in
        ENVIRONMENT)
            log "Setting environment to: $value"
            echo "ENVIRONMENT=$value" >> {{ metadata_path }}/instance-info.txt
            ;;
        APP_NAME)
            log "Setting app name to: $value"
            echo "APP_NAME=$value" >> {{ metadata_path }}/instance-info.txt
            ;;
        CUSTOM_MESSAGE)
            log "Setting custom message: $value"
            echo "CUSTOM_MESSAGE=$value" >> {{ metadata_path }}/instance-info.txt
            ;;
        *)
            log "Unknown parameter: $key=$value"
            ;;
    esac
done <<< "$USERDATA"

log "Userdata processing completed"
